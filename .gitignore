.env.local
.env.*.local

# 日志
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# uni-app / HBuilderX
unpackage/
.hbuilderx/

# 测试与缓存
coverage/
.cache/

# AI 工具本地私有配置（团队级配置入库，个人本地覆盖不入库）
.claude/settings.local.json
.claude/*.local.json

#trellis
.agents
.claude
.codex
.trellis

# 模型质量探针（本地私有工具）
