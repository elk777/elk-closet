# 开发环境（连本地 docker 容器）非敏感值（入库）
# 密钥仍从 .env.local 注入

NODE_ENV=development
PORT=3000

# 本地 docker-compose 起的 postgres / redis（宿主机端口错开 5433/6380，避开已占用的 5432/6379）
DATABASE_URL=postgresql://zhiyi:zhiyi@localhost:5433/zhiyi?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# 开发用弱 secret；生产由 .env.production / 系统环境变量覆盖
JWT_SECRET=dev-only-change-me-in-production
