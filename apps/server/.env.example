# 知衣后端环境变量模板
# ─────────────────────────────────────────────────────────────
# 加载优先级（后者覆盖前者）：.env → .env.{NODE_ENV} → .env.local → .env.{NODE_ENV}.local
# 非敏感默认值放 .env / .env.development / .env.production（入库）
# 密钥（AI key、又拍云密码、JWT secret）只放 .env.local（不入库）
# 复制本文件为 .env.local 并填入真实密钥即可本地开发
# ─────────────────────────────────────────────────────────────

# ── 应用 ──
NODE_ENV=development
PORT=3000
# API 统一前缀，Nginx 按此分流
API_PREFIX=api

# ── 数据库（PostgreSQL）──
# Prisma 用单一连接串；本地连 docker 容器
DATABASE_URL=postgresql://zhiyi:zhiyi@localhost:5432/zhiyi?schema=public

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──
# 生产必须换成足够长的随机串（openssl rand -base64 48）
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=30d

# ── AI 大模型（多渠道多模型，双协议兼容）──
# 结构：渠道表 + 能力路由。加渠道=加一条渠道；某能力换模型=改该能力路由一行。
#
# 1) 渠道表：AI_CHANNEL_<渠道名>__<字段>
#    <渠道名> 用户自定义（大写，解析时转小写供路由引用）；<字段> ∈ PROTOCOL|BASE_URL|API_KEY
#    PROTOCOL ∈ anthropic（走 @anthropic-ai/sdk，/anthropic 端点）| openai（走 openai SDK，/v1 端点）
AI_CHANNEL_MIMO__PROTOCOL=anthropic
AI_CHANNEL_MIMO__BASE_URL=https://your-gateway/anthropic
AI_CHANNEL_MIMO__API_KEY=
# 再配一个 OpenAI 兼容渠道示例（按需启用）
AI_CHANNEL_GPT__PROTOCOL=openai
AI_CHANNEL_GPT__BASE_URL=https://your-gateway/v1
AI_CHANNEL_GPT__API_KEY=
#
# 2) 能力路由：AI_ROUTE_<能力>__<字段>
#    <能力> ∈ RECOGNIZE（识别）| RECOMMEND（推荐）| GUESS（打卡预猜）| TRYON（AI 试穿）
#    四项都必须配置：启动时 env.validation 会逐个校验，缺任一即启动失败。
#    CHANNEL 指向上面某渠道名；MODEL 该能力用的模型；VISION 该模型是否支持传图
#    识别/预猜靠传图，须 VISION=true；模型不支持传图时置 false，这两能力直接走降级
#    可选兜底：FALLBACK_CHANNEL + FALLBACK_MODEL（须成对配置），主「渠道+模型」
#    失败时自动切兜底再试一次；兜底模型须具备同等能力（如 vision）。不配则失败后同路由重试 1 次。
#    可选超时：TIMEOUT_MS（≥1000 的整数毫秒）按能力覆盖全局 AI_TIMEOUT_MS，
#    主/兜底两条腿都生效，且会关闭 SDK 内建重试（预算不被重试翻倍）。
#    用途：全局值为最慢能力（试穿生图）而设时，给交互敏感能力（如识别）配紧预算，
#    主模型卡死能赶在前端超时前切兜底返回。
AI_ROUTE_RECOGNIZE__CHANNEL=mimo
AI_ROUTE_RECOGNIZE__MODEL=claude-sonnet-4-6
AI_ROUTE_RECOGNIZE__VISION=true
# 识别兜底示例（按需启用）：
# AI_ROUTE_RECOGNIZE__FALLBACK_CHANNEL=gpt
# AI_ROUTE_RECOGNIZE__FALLBACK_MODEL=deepseek-v4-vision
# 识别专属超时示例（按需启用）：
# AI_ROUTE_RECOGNIZE__TIMEOUT_MS=30000
# 推荐纯文本，无需 vision
AI_ROUTE_RECOMMEND__CHANNEL=mimo
AI_ROUTE_RECOMMEND__MODEL=claude-sonnet-4-6
AI_ROUTE_RECOMMEND__VISION=false
AI_ROUTE_GUESS__CHANNEL=mimo
AI_ROUTE_GUESS__MODEL=claude-sonnet-4-6
AI_ROUTE_GUESS__VISION=true
# 试穿要把衣服「画」到全身照上（走 images.edit），对话模型做不了，必须专用图像模型。
# 指向一个支持 openai 协议图像接口的渠道。
AI_ROUTE_TRYON__CHANNEL=gpt
AI_ROUTE_TRYON__MODEL=gpt-image-2
AI_ROUTE_TRYON__VISION=true
# 单次调用超时（毫秒），所有渠道共用；能力级 AI_ROUTE_*__TIMEOUT_MS 可按需覆盖。
# 试穿生图单次要 1~3 分钟，此值须高于图像模型的最长耗时。
AI_TIMEOUT_MS=180000

# ── 又拍云对象存储 ──
UPYUN_BUCKET=your-bucket
UPYUN_OPERATOR=your-operator
UPYUN_PASSWORD=
# CDN 加速域名（衣物图公开读，直出）
UPYUN_DOMAIN=https://your-bucket.test.upcdn.net
# 上传目录前缀
UPYUN_UPLOAD_DIR=garments
# 直传签名有效期（秒）
UPYUN_SIGN_EXPIRE=600

# ── 和风天气（今日推荐的天气输入）──
# 全部可选：未配置时今日推荐按季节降级，不阻塞链路。
# apiHost 为账号专属域名（和风控制台「设置」页可见，形如 https://xxxx.qweatherapi.com）
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 定位失败 / 未授权时的兜底城市经纬度，默认北京
QWEATHER_DEFAULT_LON=116.41
QWEATHER_DEFAULT_LAT=39.90
