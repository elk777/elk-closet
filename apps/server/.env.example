# 知衣后端环境变量模板
# ─────────────────────────────────────────────────────────────
# 加载优先级（后者覆盖前者）：.env → .env.{NODE_ENV} → .env.local → .env.{NODE_ENV}.local
# 非敏感默认值放 .env / .env.development / .env.production（入库）
# 密钥（AI key、又拍云密码、JWT secret）只放 .env.local（不入库）
# 复制本文件为 .env.local 并填入真实密钥即可本地开发
# ─────────────────────────────────────────────────────────────

# ── 应用 ──
NODE_ENV=development
PORT=3000
# API 统一前缀，Nginx 按此分流
API_PREFIX=api

# ── 数据库（PostgreSQL）──
# Prisma 用单一连接串；本地连 docker 容器
DATABASE_URL=postgresql://zhiyi:zhiyi@localhost:5432/zhiyi?schema=public

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──
# 生产必须换成足够长的随机串（openssl rand -base64 48）
JWT_SECRET=dev-only-change-me-in-production
JWT_EXPIRES_IN=30d

# ── AI 大模型 ──
# 切换协议：anthropic | openai
AI_PROVIDER=anthropic
# Anthropic 协议（/anthropic 端点）
AI_ANTHROPIC_BASE_URL=https://your-gateway/anthropic
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAI 兼容协议（/v1 端点）
AI_OPENAI_BASE_URL=https://your-gateway/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o
# 单次识别超时（毫秒）
AI_TIMEOUT_MS=30000

# ── 又拍云对象存储 ──
UPYUN_BUCKET=your-bucket
UPYUN_OPERATOR=your-operator
UPYUN_PASSWORD=
# CDN 加速域名（衣物图公开读，直出）
UPYUN_DOMAIN=https://your-bucket.test.upcdn.net
# 上传目录前缀
UPYUN_UPLOAD_DIR=garments
# 直传签名有效期（秒）
UPYUN_SIGN_EXPIRE=600
