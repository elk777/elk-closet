# 生产环境非敏感值（入库）
# ⚠️ 所有密钥（DATABASE_URL 密码、REDIS_PASSWORD、JWT_SECRET、AI key、又拍云密码）
#    绝不写在此文件，一律由部署环境的系统环境变量或 .env.production.local 注入

NODE_ENV=production
PORT=3000

# 连生产 pg / redis（host 走 docker-compose 服务名或内网地址）
# DATABASE_URL 的密码段由系统环境变量覆盖，此处仅占位结构
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# 生产 CDN 域名按实际备案域名填
# UPYUN_DOMAIN=https://cdn.your-domain.com
